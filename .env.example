SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_cli_or_dashboard_webhook_secret
# Immutable identifier recorded with each purchase's accepted checkout terms.
CANARY_OFFER_VERSION=public-credit-offer-v1

# Public credit conversion. Provider USD is converted to credits once in
# server/credits.py; purchase packages grant credits directly.
# Markup 2.0 = ~48% net gross margin after Stripe. See
# docs/proposals/pricing-and-margin.md for the cost model + rationale.
PULP_CREDITS_PER_PROVIDER_USD=100
PULP_MODEL_COST_MARKUP=2.0
PULP_RESERVATION_BUFFER=1.25
PULP_PRICING_REFRESH_DAYS=7

# When running via docker compose, LITELLM_BASE_URL is set automatically to
# http://litellm:4000 in docker-compose.yml. Only set this for local dev
# (pipeline serve outside of Docker).
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-canary
AI_BILL_FAILED_REQUESTS=provider_usage_only

# Feature flags. Labs (image-model experimentation) is on by default; set to
# false in production to shrink the public attack surface.
CANARY_LABS_ENABLED=false
# Operator-only bearer token for /api/ops/* endpoints. Generate a unique
# production value with `openssl rand -hex 32`; never expose it to the browser.
CANARY_OPS_TOKEN=replace-with-random-operator-token
# Optional allowlist for a local Vite operator desk connecting to this server.
# In production, set this explicitly to the exact local origin you use.
# CANARY_BACKOFFICE_ORIGINS=http://localhost:5173

# Shared source-input budgets. Upload validation, Stage 1, and remote sample
# imports use these same limits.
CANARY_MAX_UPLOAD_MB=10
CANARY_MAX_PDF_PAGES=300
CANARY_MAX_EPUB_DOCUMENTS=500
CANARY_MAX_EXTRACTED_CHARACTERS=2000000
CANARY_MAX_REMOTE_COMPRESSED_MB=5
CANARY_MAX_REMOTE_DECOMPRESSED_CHARACTERS=2000000
CANARY_MAX_EXTRACTION_SECONDS=30
# Process-local active heavy-work ceiling per authenticated user.
CANARY_MAX_ACTIVE_GENERATION_JOBS_PER_USER=1

# Error monitoring. Leave DSNs empty to no-op. Start with low trace sampling;
# keep replay disabled until the masked payload has been verified in Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# LiteLLM service configuration. Canary runtime reads only the LITELLM_* values
# above; provider keys are consumed by the LiteLLM proxy container.
LITELLM_MASTER_KEY=sk-local-canary
LITELLM_SALT_KEY=replace-with-local-dev-secret
# Postgres backing the LiteLLM proxy (key-auth + spend tracking). The
# docker-compose.yml `litellm-db` service provides this by default; override
# only if you point LiteLLM at an external DB. LiteLLM runs its own Prisma
# migrations on first boot.
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
# Vertex AI credentials take ONE of two forms (set the one that matches your
# environment). Without them the LiteLLM proxy boots fine but every Vertex
# model group 500s at request time and the pipeline can't run.
#
#   A) FLY / SINGLE-CONTAINER (scripts/dev-prod.sh, canary-prod):
#        GCP_CREDENTIALS_B64 = base64 of your service-account JSON.
#      (The Dockerfile entrypoint decodes it to /app/gcp-credentials.json.)
#        base64 -w0 path/to/sa.json   # GNU
#        base64 -i path/to/sa.json    # macOS
#
#   B) SEPARATE litellm CONTAINER (docker-compose.yml `litellm` service):
#        GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH = host path to the JSON.
#      (Mounted into that container as /app/gcp-credentials.json.)
# Download the key from: GCP Console → IAM → Service Accounts → Keys → Add Key (JSON)
GCP_CREDENTIALS_B64=
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=./litellm/gcp-credentials.json
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Host the LiteLLM Docker container uses to reach Langfuse (Docker network name).
LANGFUSE_HOST=http://langfuse-web:3000
# Host the Canary app uses to reach Langfuse. When the app runs outside Docker,
# this should be the host-published port. Falls back to LANGFUSE_HOST if unset.
CANARY_LANGFUSE_HOST=http://localhost:3000

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FAL_KEY=
REVE_API_KEY=

R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Brand + legal identity (all optional — sensible Scenewright defaults apply).
# Surfaced via /api/branding and the legal pages; used for Stripe line items
# and the report-abuse / DMCA contact. None are secrets.
# ---------------------------------------------------------------------------
# SCENEWRIGHT_PRODUCT_NAME=Scenewright
# SCENEWRIGHT_SUPPORT_EMAIL=hello@scenewright.ink
# SCENEWRIGHT_LEGAL_EMAIL=legal@scenewright.ink
# SCENEWRIGHT_TERMS_URL=https://scenewright.ink/legal/terms
# Trusted origin for Stripe success/cancel redirects. Required in production.
# SCENEWRIGHT_APP_URL=https://app.scenewright.ink
# Public HTTPS URL for the square Scenewright mark displayed by Stripe Checkout.
# Stripe fetches this asset server-side; do not use localhost here.
# SCENEWRIGHT_STRIPE_ICON_URL=https://app.scenewright.ink/favicon.svg
# Comma-separated hostnames accepted by TrustedHostMiddleware in production.
# CANARY_ALLOWED_HOSTS=app.scenewright.ink
