SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_cli_or_dashboard_webhook_secret
# Immutable identifier recorded with each purchase's accepted checkout terms.
CANARY_OFFER_VERSION=public-credit-offer-v1

# Public credit conversion. Provider USD is converted to credits once in
# server/credits.py; purchase packages grant credits directly.
# Markup 2.0 = ~48% net gross margin after Stripe. See
# docs/proposals/pricing-and-margin.md for the cost model + rationale.
PULP_CREDITS_PER_PROVIDER_USD=100
PULP_MODEL_COST_MARKUP=2.0
PULP_RESERVATION_BUFFER=1.25
PULP_PRICING_REFRESH_DAYS=7

# When running via docker compose, LITELLM_BASE_URL is set automatically to
# http://litellm:4000 in docker-compose.yml. Only set this for local dev
# (pipeline serve outside of Docker).
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-canary
AI_BILL_FAILED_REQUESTS=provider_usage_only

# Labs are available only in local development.
CANARY_LABS_ENABLED=false
# Operator-only bearer token for /api/ops/* endpoints. Generate a unique
# production value with `openssl rand -hex 32`; never expose it to the browser.
CANARY_OPS_TOKEN=replace-with-random-operator-token
# Optional allowlist for a local Vite operator desk connecting to this server.
# In production, set this explicitly to the exact local origin you use.
# CANARY_BACKOFFICE_ORIGINS=http://localhost:5173

# Shared source-input budgets. Upload validation, Stage 1, and remote sample
# imports use these same limits.
CANARY_MAX_UPLOAD_MB=50
CANARY_MAX_PDF_PAGES=2000
CANARY_MAX_EPUB_DOCUMENTS=500
CANARY_MAX_EXTRACTED_CHARACTERS=5000000
CANARY_MAX_REMOTE_COMPRESSED_MB=5
CANARY_MAX_REMOTE_DECOMPRESSED_CHARACTERS=2000000
CANARY_MAX_EXTRACTION_SECONDS=60
# Legacy synchronous/fixture ceiling. Durable jobs always serialize per account.
CANARY_MAX_ACTIVE_GENERATION_JOBS_PER_USER=1

# PostHog Cloud. No token/host = no telemetry, no local services required.
# Choose the SAME region for server, browser and source-map uploads.
# Dev launchers derive absent VITE_POSTHOG_* settings from the backend values;
# uncomment the empty VITE_* overrides below to explicitly disable browser capture.
# Detailed local diagnostic files are opt-in; accounting/recovery records are independent.
CANARY_LOCAL_DIAGNOSTICS=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
POSTHOG_TRACE_SAMPLE_RATE=1
# Development only: AI traces include prompt and output bodies. Set false to keep
# local traces metadata-only. Ignored unless CANARY_ENV=development.
CANARY_AI_CONTENT_CAPTURE=true
# VITE_POSTHOG_PROJECT_TOKEN=
# VITE_POSTHOG_HOST=
# Source-map upload only: project numeric ID + private phx_ key with write scope.
# Never prefix the personal API key with VITE_; CI passes it as a build secret.
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=

# LiteLLM service configuration. Canary runtime reads only the LITELLM_* values
# above; provider keys are consumed by the LiteLLM proxy container.
LITELLM_MASTER_KEY=sk-local-canary
LITELLM_SALT_KEY=replace-with-local-dev-secret
# Postgres backing the LiteLLM proxy (key-auth + spend tracking). The
# docker-compose.yml `litellm-db` service provides this by default; override
# only if you point LiteLLM at an external DB. LiteLLM runs its own Prisma
# migrations on first boot.
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm
ANTHROPIC_API_KEY=
# Claude through AWS Bedrock. Global profiles can route outside this source region.
# Use a Bedrock API key OR the standard AWS credential chain (IAM role or keys).
AWS_REGION_NAME=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Include the session token when using temporary AWS credentials.
AWS_SESSION_TOKEN=
# Optional local `aws login` session; dev.sh selects docker-compose.aws-login.yml
# when the cache directory is set. Use absolute paths; no keys belong here.
# AWS_PROFILE=default
# CANARY_AWS_CONFIG_FILE=/absolute/path/to/.aws/config
# CANARY_AWS_LOGIN_CACHE_DIRECTORY=/absolute/path/to/.aws/login/cache
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Gemini text through Vertex AI. Set the project with your Cloud credits.
# This route uses ADC; GEMINI_API_KEY does not authenticate it.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
# Optional local Docker ADC mount; dev.sh selects docker-compose.vertex.yml
# when this is set. Use an absolute path to the JSON credentials file.
# CANARY_VERTEX_CREDENTIALS_FILE=/absolute/path/to/application_default_credentials.json
# For a gateway running outside Docker, use GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
FAL_KEY=
# Optional Admin-scoped FAL key. The gateway uses it only to read the billing
# event for each completed request so Sunburst images settle at FAL's actual
# charge. Without it, those images settle at a labelled request estimate.
FAL_ADMIN_KEY=

# Account ingestion budget, including original uploads, job inputs and publication copies.
CANARY_ACCOUNT_STORAGE_BYTES=5368709120

# ---------------------------------------------------------------------------
# Brand + legal identity (all optional — sensible Scenewright defaults apply).
# Surfaced via /api/branding and the legal pages; used for Stripe line items
# and the report-abuse / DMCA contact. None are secrets.
# ---------------------------------------------------------------------------
# SCENEWRIGHT_PRODUCT_NAME=Scenewright
# SCENEWRIGHT_SUPPORT_EMAIL=hello@scenewright.ink
# SCENEWRIGHT_LEGAL_EMAIL=legal@scenewright.ink
# SCENEWRIGHT_TERMS_URL=https://scenewright.ink/legal/terms
# Trusted origin for Stripe success/cancel redirects. Required in production.
# SCENEWRIGHT_APP_URL=https://app.scenewright.ink
# Public HTTPS URL for the square Scenewright mark displayed by Stripe Checkout.
# Stripe fetches this asset server-side; do not use localhost here.
# SCENEWRIGHT_STRIPE_ICON_URL=https://app.scenewright.ink/favicon.svg
# Comma-separated hostnames accepted by TrustedHostMiddleware in production.
# CANARY_ALLOWED_HOSTS=app.scenewright.ink

# Optional exact reasoning-model allowlist for the local account selector.
# Applies only with CANARY_CODEX_DEV_ENABLED=1; restart after changes.
# CANARY_CODEX_DEV_MODELS=["gpt-5.6-terra","gpt-5.6-luna","gpt-5.5"]

# Durable generation queue (PostgreSQL, not Supabase REST or LiteLLM).
# Production may use a private Supabase schema selected by its dedicated role.
# scripts/dev.sh starts queue-db and initializes its fresh schema locally.
CANARY_QUEUE_DATABASE_URL=postgresql://canary:canary-local@127.0.0.1:55432/canary_queue
CANARY_BATCH_JOB_TIMEOUT_SECONDS=7200
