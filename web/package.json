{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "brand:build": "node --experimental-strip-types brand-system/src/build.ts",
    "brand:check": "tsc -p brand-system/tsconfig.json && node --experimental-strip-types brand-system/src/validate.ts",
    "brand:preview": "npm run brand:build && vite --open /brand-system/preview/",
    "dev": "vite",
    "build": "npm run i18n:check && tsc -b && vite build && npm run perf:check",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "perf:check": "node scripts/check-performance.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "i18n:check": "node scripts/catalogs.mjs",
    "i18n:extract": "node scripts/catalogs.mjs --extract"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "intl-messageformat": "^12.1.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "^5.0.15",
    "posthog-js": "^1.434.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas": "^3.2.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "mock-match-media": "^1.0.3",
    "resize-observer-polyfill": "^1.5.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@posthog/rollup-plugin": "^1.6.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
