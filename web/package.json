{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "brand:build": "node --experimental-strip-types brand-system/src/build.ts",
    "brand:check": "tsc -p brand-system/tsconfig.json && node --experimental-strip-types brand-system/src/validate.ts",
    "brand:preview": "npm run brand:build && vite --open /brand-system/preview/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit:production": "node scripts/audit-production.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@sentry/react": "^8.0.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tanstack/react-query": "^5.99.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
