# Frontend build-time env. Vite inlines VITE_* vars into the JS bundle at build
# time (the browser talks to Supabase directly for auth). Pass these to the
# Docker build via `--build-arg VITE_...=...`. The publishable key is safe to
# expose — Supabase anon keys are public, gated by RLS.
#
# scripts/dev-prod.sh reads this file (and the root .env) automatically when
# booting the prod-parity Docker container, so populating it is required for
# prod-parity testing. VITE_SUPABASE_URL is derived from SUPABASE_URL if you
# leave it unset here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional — leaves frontend Sentry disabled if unset.
VITE_SENTRY_DSN=
VITE_CANARY_ENV=production
# Optional local operator desk connection. Leave the URL blank to use the
# same-origin dev proxy; set it to the production origin when inspecting prod.
VITE_BACKOFFICE_API_URL=
# Optional convenience only for a private local dev session. Vite exposes all
# VITE_* values to the browser; prefer entering CANARY_OPS_TOKEN in the desk.
# VITE_BACKOFFICE_OPS_TOKEN=
