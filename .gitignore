# ── Generated comic assets (large, regenerable — re-run the pipeline) ────────
# Heavy/regenerable directories and binary outputs inside any project.
# Lightweight JSON artifacts (state, config, story bible, scenes, screenplays,
# panels, prompts) are NOT ignored — they let you resume a run without
# regenerating, and diff cleanly in PRs.
projects/*
# projects/*/input/
# projects/*/images/
# projects/*/refs/
# projects/*/plates/
# projects/*/exports/
# projects/*/qdrant_data/
# projects/*/.qdrant/
# projects/*/assembly/html/
# projects/*/assembly/pages/*.png

# # Generated binaries inside any project subtree
# projects/**/*.png
# projects/**/*.jpg
# projects/**/*.jpeg
# projects/**/*.webp
# projects/**/*.pdf
# projects/**/*.cbz
# projects/**/*.zip
# projects/**/*.epub

# ── Vector store ──────────────────────────────────────────────────────────────
qdrant_storage/
.qdrant/
**/qdrant_data/

# ── Playwright ────────────────────────────────────────────────────────────────
.playwright/
playwright/.cache/

