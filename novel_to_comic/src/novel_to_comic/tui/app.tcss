/* Canary TUI — Global Styles */

Screen {
    background: $surface;
}

/* Header */
#header-bar {
    dock: top;
    height: 3;
    padding: 0 1;
    background: $primary;
}

#header-title {
    color: $text;
    text-style: bold;
    padding: 1 0;
}

/* Content area */
#main-content {
    padding: 1 2;
}

/* Action buttons row */
#actions {
    dock: bottom;
    height: auto;
    padding: 1 2;
    background: $surface-darken-1;
}

.action-row {
    height: auto;
    margin: 0;
}

.action-btn {
    margin: 0 1;
    min-width: 16;
}

/* Stage table */
StageTable {
    height: auto;
    max-height: 20;
}

StageTable .stage-row {
    height: 1;
}

/* Cost display */
CostDisplay {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $surface-darken-2;
    color: $text-muted;
    text-align: right;
}

/* Log viewer */
LogViewer {
    border: round $primary;
    height: 1fr;
    min-height: 10;
    padding: 0 1;
}

LogViewer:focus {
    border: round $accent;
}

/* Progress bar */
StageProgress {
    height: 3;
    margin: 1 0;
}

/* Dashboard */
#stage-list {
    height: auto;
    margin: 1 0;
}

#review-banner {
    background: $warning-darken-2;
    color: $text;
    padding: 0 2;
    height: 3;
    margin: 1 0;
}

/* Project screen */
.project-list {
    height: 1fr;
    margin: 1 0;
}

.project-item {
    padding: 0 1;
}

.project-item:hover {
    background: $primary-darken-2;
}

/* Pipeline screen */
#pipeline-header {
    text-style: bold;
    text-align: center;
    padding: 1;
}

/* Config screen */
ConfigScreen Input {
    margin: 0 0 1 0;
}

/* Style screen */
.style-card {
    border: round $primary;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

.style-card.active {
    border: round $success;
}

/* Gallery screen */
.panel-grid {
    height: 1fr;
}

/* Approval screen */
#approval-content {
    padding: 1 2;
    height: 1fr;
}

/* Export screen */
#export-options {
    padding: 1 2;
}

/* Regen screen */
#regen-content {
    padding: 1 2;
}

/* Screen titles */
.screen-title {
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
    width: 100%;
}
