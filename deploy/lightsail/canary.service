[Unit]
Description=Canary single-owner application with encrypted secrets
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/canary/deployment.env
WorkingDirectory=/usr/local/lib/canary
RuntimeDirectory=canary/secrets
RuntimeDirectoryMode=0700
# Live mounts must survive an unsuccessful start/update; prune removes only
# unmounted plaintext after each stop, and reboot clears the rest.
RuntimeDirectoryPreserve=yes
UMask=0077
LimitCORE=0
ExecCondition=/usr/bin/test ! -e /etc/canary/maintenance
# Refuses a host loader that differs from CANARY_LOADER_SHA256, and active unencrypted swap.
ExecStartPre=/usr/bin/python3 /usr/local/lib/canary/canary_secrets.py materialize --bundle ${CANARY_BUNDLE_PATH} --identity /etc/canary/keys/age.txt --sha256 ${CANARY_BUNDLE_SHA256}
ExecStart=/usr/bin/docker compose --env-file /dev/null --project-name canary --file /usr/local/lib/canary/compose.yaml up --no-build --pull never --force-recreate --abort-on-container-exit --exit-code-from canary
ExecStop=/usr/bin/docker compose --env-file /dev/null --project-name canary --file /usr/local/lib/canary/compose.yaml stop --timeout 30
# Plaintext does not outlive the container, including during maintenance holds.
# Failure is logged but never blocks the stop.
ExecStopPost=-/usr/bin/python3 /usr/local/lib/canary/canary_secrets.py prune
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
