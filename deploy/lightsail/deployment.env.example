# NON-SECRET settings only. Install root-owned 0600 as /etc/canary/deployment.env.
# Replace placeholders; reviewed releases pin both image and ciphertext digests.
CANARY_IMAGE=registry.example/canary@sha256:REPLACE_WITH_TESTED_IMAGE_DIGEST
CANARY_BUNDLE_PATH=/etc/canary/bundles/REPLACE_WITH_CIPHERTEXT_DIGEST.sops.json
CANARY_BUNDLE_SHA256=REPLACE_WITH_CIPHERTEXT_DIGEST
# `canary_secrets.py digest` of the reviewed release; host and image copies must match.
CANARY_LOADER_SHA256=REPLACE_WITH_LOADER_DIGEST
CANARY_ALLOWED_HOSTS=scenewright.ink,www.scenewright.ink
# Preserve the active Fly values: backoffice CORS and internal-user analytics filtering.
CANARY_BACKOFFICE_ORIGINS=
CANARY_INTERNAL_ACCOUNT_IDS=
SCENEWRIGHT_APP_URL=https://scenewright.ink
# Must be one of CANARY_ALLOWED_HOSTS, or the local health probe is rejected.
CANARY_HEALTH_HOST=scenewright.ink
SUPABASE_URL=https://REPLACE.supabase.co
# Enable only when the encrypted bundle includes ADC and refresh is verified.
VERTEXAI_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEXAI_LOCATION=global
AWS_REGION_NAME=us-east-1
# Enable after scoped credentials and the live OCR acceptance test pass.
CANARY_TEXTRACT_ENABLED=false
# New Sunburst work starts on Runware; needs RUNWARE_API_KEY in the encrypted bundle.
CANARY_RUNWARE_FIRST_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
