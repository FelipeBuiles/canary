[Unit]
Description=Canary private host maintenance control
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/canary/host_agent.py
RuntimeDirectory=canary-host
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=canary-host
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
