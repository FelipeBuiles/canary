{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Fly Prometheus",
      "description": "The Prometheus data source preconfigured in Fly Grafana",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Canary traffic, pipeline health, AI usage, provider spend, and billing integrity.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Requests",
      "description": "All application requests in the selected time range.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(canary_http_requests_total{app=\"canary-web\"}[$__range])) or vector(0)",
          "legendFormat": "requests",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixedColor", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 2,
      "title": "Server errors",
      "description": "HTTP 5xx responses in the selected time range. None is healthy.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 5, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(canary_http_requests_total{app=\"canary-web\",status_class=\"5xx\"}[$__range])) or vector(0)",
          "legendFormat": "5xx responses",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [{ "type": "value", "options": { "0": { "text": "None", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 3,
      "title": "Request p95",
      "description": "95th-percentile application response time across the selected range.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(canary_http_request_duration_seconds_bucket{app=\"canary-web\"}[$__range])))",
          "legendFormat": "latency",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 4,
      "title": "Provider spend",
      "description": "AI provider cost recorded in the selected time range. Prometheus is a recent operational signal; Supabase is the durable financial record.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(canary_ai_provider_cost_usd_total{app=\"canary-web\"}[$__range])) or vector(0)",
          "legendFormat": "total spend",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixedColor", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 5,
      "title": "Unbilled provider charges",
      "description": "Provider costs recorded when the matching customer credit debit failed. Any non-zero value needs investigation.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(canary_credit_debit_failures_total{app=\"canary-web\"}[$__range])) or vector(0)",
          "legendFormat": "debit failures",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [{ "type": "value", "options": { "0": { "text": "None", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 6,
      "title": "Traffic by route",
      "description": "The eight busiest application routes, excluding health and metrics endpoints in application instrumentation.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "topk(8, sum by (route, method) (rate(canary_http_requests_total{app=\"canary-web\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "title": "Latency by route",
      "description": "95th-percentile response time for the eight slowest active routes.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(canary_http_request_duration_seconds_bucket{app=\"canary-web\"}[$__rate_interval]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "title": "Work in progress",
      "description": "Current queued and running generation work. These are live gauges, not totals for the selected range.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 11 },
      "targets": [
        { "expr": "sum(canary_generation_jobs{app=\"canary-web\",status=\"queued\"}) or vector(0)", "legendFormat": "queued jobs", "instant": true, "refId": "A" },
        { "expr": "sum(canary_generation_jobs{app=\"canary-web\",status=\"running\"}) or vector(0)", "legendFormat": "running jobs", "instant": true, "refId": "B" },
        { "expr": "sum(canary_generation_queue_items{app=\"canary-web\"}) or vector(0)", "legendFormat": "queue depth", "instant": true, "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 6 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "vertical", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 9,
      "title": "Stage outcomes",
      "description": "Completed pipeline runs in the selected time range, split by stage and outcome.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 9, "x": 6, "y": 11 },
      "targets": [
        {
          "expr": "topk(12, sum by (stage, outcome) (increase(canary_stage_runs_total{app=\"canary-web\"}[$__range])))",
          "legendFormat": "{{stage}} · {{outcome}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "displayMode": "basic", "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" }
    },
    {
      "id": 10,
      "title": "AI calls",
      "description": "Provider calls in the selected time range, split by provider and result.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 9, "x": 15, "y": 11 },
      "targets": [
        {
          "expr": "topk(10, sum by (provider, status) (increase(canary_ai_calls_total{app=\"canary-web\"}[$__range])))",
          "legendFormat": "{{provider}} · {{status}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": { "displayMode": "basic", "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" }
    },
    {
      "id": 11,
      "title": "Spend by provider, model, and stage",
      "description": "The ten largest AI cost contributors in the selected time range. This is an aggregate ranking, not a time series.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "topk(10, sum by (provider, model, stage) (increase(canary_ai_provider_cost_usd_total{app=\"canary-web\"}[$__range])))",
          "legendFormat": "{{provider}} · {{model}} · {{stage}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "min": 0, "color": { "mode": "continuous-YlRd" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "minVizHeight": 18, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" }
    },
    {
      "id": 12,
      "title": "Stage p95 duration",
      "description": "95th-percentile duration for stages that ran in the selected time range.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, stage) (increase(canary_stage_duration_seconds_bucket{app=\"canary-web\"}[$__range]))))",
          "legendFormat": "{{stage}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "min": 0, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "displayMode": "basic", "minVizHeight": 18, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" }
    },
    {
      "id": 13,
      "title": "Plan reasoning share",
      "description": "Hidden reasoning tokens as a percentage of all plan completion tokens. Reasoning is disabled for panel routes; any sustained non-zero value needs investigation.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "100 * sum(increase(canary_ai_reasoning_tokens_total{app=\"canary-web\",stage=\"plan\"}[$__range])) / clamp_min(sum(increase(canary_ai_output_tokens_total{app=\"canary-web\",stage=\"plan\"}[$__range])), 1)",
          "legendFormat": "reasoning share",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 14,
      "title": "Plan structured retries",
      "description": "Retry attempts as a percentage of all plan structured-call attempts. Local deterministic repair should keep this near zero.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 26 },
      "targets": [
        {
          "expr": "100 * sum(increase(canary_structured_call_attempts_total{app=\"canary-web\",feature=\"plan.scene_layout\",attempt=\"retry\"}[$__range])) / clamp_min(sum(increase(canary_structured_call_attempts_total{app=\"canary-web\",feature=\"plan.scene_layout\"}[$__range])), 1)",
          "legendFormat": "retry share",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    },
    {
      "id": 15,
      "title": "Plan estimate drift",
      "description": "95th-percentile actual-to-estimated provider-cost ratio for completed plan stages. Above 1.25 means the reservation buffer is no longer covering observed cost.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 26 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(canary_stage_cost_ratio_bucket{app=\"canary-web\",stage=\"plan\"}[$__range])))",
          "legendFormat": "actual / estimate",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1.25 }, { "color": "red", "value": 2 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["canary", "fly", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Canary operations",
  "uid": "canary-application",
  "version": 3
}
