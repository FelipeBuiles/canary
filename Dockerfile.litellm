# LiteLLM gateway image for Fly.io (app: litellm-gw).
#
# Built from the repo root so the context can see both litellm/ (config) and
# litellm_handlers/ (custom Vertex/fal/Reve providers):
#   fly deploy --config fly.litellm.toml
#
# This mirrors the docker-compose litellm service: config.yaml + handlers are
# baked in (Fly can't bind-mount), and GCP creds are injected at runtime.

FROM docker.litellm.ai/berriai/litellm:main-v1.83.14-stable

WORKDIR /app

COPY litellm/config.yaml /app/config.yaml
COPY litellm_handlers/ /app/litellm_handlers/
COPY litellm/entrypoint.sh /app/entrypoint.sh

ENV PYTHONPATH=/app:/app/litellm_handlers \
    GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
